CLOUDINARY_CLOUD_NAME=c9ide1cv
CLOUDINARY_API_KEY=replace_in_render
CLOUDINARY_API_SECRET=replace_in_render
FIREBASE_PROJECT_ID=reshare-13234
PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
ADMIN_WEB_ORIGINS=https://your-reshare-web-domain.example
# Đặt đúng origin của landing page khi dùng API liên hệ ở tên miền khác.
# CONTACT_ALLOWED_ORIGIN=

# AI gắn cờ bài Kho đồ 0đ; thiếu một biến thì tắt, không gọi dịch vụ.
# URL gốc tương thích OpenAI, kết thúc trước /chat/completions; model phải hỗ trợ ảnh.
# Chỉ HTTPS; HTTP chỉ dành cho localhost hoặc 127.0.0.1 khi kiểm thử local.
AI_MODERATION_BASE_URL=
AI_MODERATION_API_KEY=
AI_MODERATION_MODEL=

# Số bài tối đa mỗi lượt. Mặc định 30, trong khoảng 1–50.
AI_MODERATION_BATCH_SIZE=
# Số bài kiểm song song trong mỗi process. Mặc định 3, trong khoảng 1–5.
AI_MODERATION_CONCURRENCY=
# Thời gian giữa các lượt, tính bằng mili giây. Mặc định 180000, trong khoảng 60000–3600000.
AI_MODERATION_INTERVAL_MS=
# Timeout gọi model, tính bằng mili giây. Mặc định 15000, trong khoảng 5000–120000.
AI_MODERATION_TIMEOUT_MS=

# Bật bằng on; mặc định off. Chỉ tự gỡ bài đang mở có nghi vấn vi phạm nặng.
AI_MODERATION_AUTO_REMOVE=
# Ngưỡng ban đầu, chưa hiệu chuẩn. Mặc định 0.9, trong khoảng 0.5–1.
AI_MODERATION_AUTO_REMOVE_THRESHOLD=

# RC1D-144 — giới hạn request (để trống = dùng mặc định).
# Đặt off để tắt giới hạn theo IP khi cần quay lại hành vi cũ.
RATE_LIMIT_ENABLED=
# Số request tối đa mỗi IP trong một cửa sổ. Mặc định 120.
RATE_LIMIT_GENERAL_PER_MINUTE=
# Số request POST (ghi dữ liệu, upload, form liên hệ) tối đa mỗi IP. Mặc định 20.
RATE_LIMIT_WRITE_PER_MINUTE=
# Độ dài cửa sổ đếm, tính bằng mili giây. Mặc định 60000.
RATE_LIMIT_WINDOW_MS=
# Số proxy tin cậy đứng trước backend (Render = 1). 0 = chỉ dùng IP socket.
TRUSTED_PROXY_HOPS=
# Luồng SSE tồn kho: số kết nối cùng lúc mỗi tài khoản (mặc định 3) và số lần mở lại mỗi phút (mặc định 10).
SSE_MAX_CONNECTIONS_PER_USER=
SSE_RECONNECTS_PER_MINUTE=
# Timeout nhận header và toàn bộ request, mili giây. Mặc định 15000 và 30000.
SERVER_HEADERS_TIMEOUT_MS=
SERVER_REQUEST_TIMEOUT_MS=
# Chỉ đặt khi API đã đi qua Cloudflare: Cloudflare gửi header X-Edge-Secret với giá trị này,
# request thiếu/sai bị 403 (trừ /health). Để trống = không kiểm.
EDGE_SECRET=
