CLOUDINARY_CLOUD_NAME=c9ide1cv
CLOUDINARY_API_KEY=replace_in_render
CLOUDINARY_API_SECRET=replace_in_render
FIREBASE_PROJECT_ID=reshare-13234
PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
ADMIN_WEB_ORIGINS=https://your-reshare-web-domain.example
# Đặt đúng origin của landing page khi dùng API liên hệ ở tên miền khác.
# CONTACT_ALLOWED_ORIGIN=

# AI gắn cờ bài Kho đồ 0đ; thiếu một biến thì tắt, không gọi dịch vụ.
# URL gốc tương thích OpenAI, kết thúc trước /chat/completions; model phải hỗ trợ ảnh.
# Chỉ HTTPS; HTTP chỉ dành cho localhost hoặc 127.0.0.1 khi kiểm thử local.
AI_MODERATION_BASE_URL=
AI_MODERATION_API_KEY=
AI_MODERATION_MODEL=

# Số bài tối đa mỗi lượt. Mặc định 30, trong khoảng 1–50.
AI_MODERATION_BATCH_SIZE=
# Số bài kiểm song song trong mỗi process. Mặc định 3, trong khoảng 1–5.
AI_MODERATION_CONCURRENCY=
# Thời gian giữa các lượt, tính bằng mili giây. Mặc định 180000, trong khoảng 60000–3600000.
AI_MODERATION_INTERVAL_MS=
# Timeout gọi model, tính bằng mili giây. Mặc định 15000, trong khoảng 5000–120000.
AI_MODERATION_TIMEOUT_MS=
