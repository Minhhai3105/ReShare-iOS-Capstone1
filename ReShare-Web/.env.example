# Backend mặc định PORT=3000; nếu đổi PORT thì cập nhật URL này tương ứng.
# Inventory dev yêu cầu URL tường minh; production bỏ trống mới dùng Render mặc định.
VITE_ADMIN_API_BASE_URL=http://localhost:3000

# Kho mặc định dùng API thật. Dev cần cấu hình VITE_ADMIN_API_BASE_URL ở trên.
# Chỉ bật mock khi phát triển giao diện; build sẽ từ chối nguồn mock.
# VITE_INVENTORY_SOURCE=mock

# Bắt buộc cho form liên hệ ở bản production khi API ở tên miền khác.
# The backend must allow this site's exact origin via CONTACT_ALLOWED_ORIGIN.
# VITE_CONTACT_API_URL=https://backend.example/v1/contact

# Local development proxy target; defaults to the existing backend on port 3000.
# VITE_CONTACT_PROXY_TARGET=http://127.0.0.1:3000

# Origin công khai của site, dùng để sinh URL tuyệt đối cho og-image khi share link.
# Bỏ trống thì og-image là đường dẫn tương đối và preview trên Facebook/Zalo sẽ không hiện ảnh.
# Phải set ở build env của Cloudflare Pages.
# PUBLIC_SITE_URL=https://reshare.pages.dev
