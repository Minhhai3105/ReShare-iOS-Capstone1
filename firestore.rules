rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeStaffWithRole(role) {
      let path = /databases/$(database)/documents/staff_assignments/$(request.auth.uid);
      return request.auth != null
        && exists(path)
        && get(path).data.get('active', false) == true
        && get(path).data.get('role', null) == role;
    }

    function isSystemAdmin() {
      return activeStaffWithRole('system_admin');
    }

    function canReadWarehouse(warehouseId) {
      let path = /databases/$(database)/documents/staff_assignments/$(request.auth.uid);
      return isSystemAdmin() || (
        activeStaffWithRole('warehouse_admin')
        && get(path).data.get('warehouseIds', []) is list
        && warehouseId in get(path).data.warehouseIds
      );
    }

    // Quyền nhân sự chỉ do Admin SDK ghi; client được đọc để dựng UI, không tự cấp quyền.
    match /staff_assignments/{staffId} {
      allow get: if request.auth != null && (request.auth.uid == staffId || isSystemAdmin());
      allow list: if isSystemAdmin();
      allow write: if false;
    }

    match /staff_assignment_audit/{eventId} {
      allow read: if isSystemAdmin();
      allow write: if false;
    }

    // Nhân viên kho chỉ được lấy từng kho được gán; truy vấn toàn bộ dành cho System Admin.
    match /warehouses/{warehouseId} {
      allow get: if request.auth != null && canReadWarehouse(warehouseId);
      allow list: if isSystemAdmin();
      allow write: if false;
    }

    // An toàn nội dung (App Store Guideline 1.2). Danh sách từ lấy từ
    // ReShare/ReShare/Core/ContentFilter.swift; regex dưới đây SINH TỰ ĐỘNG bằng
    // `node tests/content-filter-pattern.cjs` — test web `content-filter-sync` bắt lệch.
    // Chỉ dùng từ đủ đặc trưng để không chặn nhầm từ thường (vd. không dùng "đĩ" vì có trong "đĩa").
    function cleanText(text) {
      // (?i) thay cho lower(): lower() của Rules chỉ đổi chữ ASCII nên "ĐÉO" sẽ lọt.
      // Rules không chuẩn hoá Unicode, nên mỗi chữ có dấu liệt kê cả dạng dựng sẵn (NFC) lẫn dạng
      // dấu tổ hợp (NFD, vd. "e" + \x{301}) — app chuẩn hoá NFC trước khi lọc, Rules phải bắt cả hai.
      return !(text is string) || !text.matches(
        '(?si).*(đ(?:i\\x{323}|ị)t|đ(?:u\\x{323}|ụ) m(?:a\\x{301}|á)|đ(?:u\\x{323}|ụ) m(?:e\\x{323}|ẹ)|đ(?:e\\x{301}|é)o|l(?:o\\x{302}\\x{300}|ô\\x{300}|ồ)n|bu(?:o\\x{302}\\x{300}|ô\\x{300}|ồ)i|c(?:a\\x{306}\\x{323}|a\\x{323}\\x{306}|ă\\x{323}|ạ\\x{306}|ặ)c|con đ(?:i\\x{303}|ĩ)|đ(?:o\\x{302}\\x{300}|ô\\x{300}|ồ) đ(?:i\\x{303}|ĩ)|đmm|đcm|dcm|vcl|vkl|fuck|shit|bitch|cunt).*');
    }

    // Tài khoản bị System Admin khoá (moderation-api ghi users/{uid}.suspended). ID token đã cấp vẫn
    // còn hạn tới 1 giờ sau khi thu hồi phiên, nên Rules chặn ghi nội dung ngay thay vì chờ token hết hạn.
    function isSuspended() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.get('suspended', false) == true;
    }

    // Một trong hai người đã chặn người kia thì không được mở hội thoại hay nhắn tin cho nhau.
    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function validCloudinaryImages(purpose, recordId) {
      let ids = request.resource.data.get('imagePublicIds', null);
      let provider = request.resource.data.get('imageProvider', null);
      let batchPath = /databases/$(database)/documents/image_upload_batches/$(purpose + '_' + recordId);
      return (ids == null && provider != 'cloudinary') ||
        (provider == 'cloudinary'
          && ids is list
          && ids.size() >= 3
          && ids.size() <= 6
          && ids.toSet().size() == ids.size()
          && exists(batchPath)
          && get(batchPath).data.ownerUid == request.auth.uid
          && get(batchPath).data.assets.values().hasAll(ids));
    }

    // 1. Users Profile (Chỉ chính chủ mới có quyền đọc và sửa thông tin cá nhân của mình)
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validPublicProfile() {
        return request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.size() <= 32;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'id', 'email', 'displayName', 'phoneNumber', 'role', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'email', 'displayName', 'phoneNumber', 'role', 'createdAt'
        ])
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'donor'
        && request.resource.data.createdAt is timestamp
        && validPublicProfile();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber'
        ])
        && validPublicProfile();
      allow delete: if false;

      // Danh sách người dùng mình đã chặn: chỉ chính chủ đọc, thêm, gỡ.
      match /blocks/{blockedId} {
        allow read, delete: if isOwner();
        allow create: if isOwner()
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['blockedUid', 'createdAt', 'displayName'])
          && request.resource.data.blockedUid == blockedId
          && request.resource.data.createdAt == request.time
          // Tên lưu kèm để màn "Người dùng đã chặn" hiển thị được (hồ sơ người khác không đọc được).
          && (!request.resource.data.keys().hasAny(['displayName']) ||
              (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80));
        allow update: if false;
      }
    }

    // 2. Catalog Items (Kho đồ 0đ P2P C2C)
    match /catalog_items/{itemId} {
      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function reservationMatchesConversation() {
        let chat = getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.reservedChatId)).data;
        return chat.itemId == itemId && chat.donorId == request.auth.uid
          && chat.requesterId == request.resource.data.reservedRequesterId
          && chat.get('isReserved', false) == true && chat.get('appointmentStatus', 'none') == 'accepted'
          && chat.get('proposedPickupTime', null) is timestamp
          && chat.get('reservationDeadline', null) == request.resource.data.reservationDeadline
          && request.resource.data.reservationDeadline == chat.proposedPickupTime + duration.value(2, 'h');
      }

      function canReserve() {
        return request.auth.uid == resource.data.donorId
          && resource.data.status in ['available', 'Sẵn sàng nhận đồ']
          && request.resource.data.status == 'reserved'
          // Giờ hẹn chỉ nằm trong hội thoại (chỉ 2 bên đọc được), không ghi lên bài công khai.
          && changedOnly([
            'status', 'reservedChatId', 'reservedRequesterId',
            'reservationDeadline', 'donorHandoverConfirmed', 'requesterHandoverConfirmed'
          ])
          && request.resource.data.get('reservedChatId', null) is string
          && request.resource.data.get('reservedRequesterId', null) is string
          && request.resource.data.reservedRequesterId != request.auth.uid
          && request.resource.data.get('reservationDeadline', null) is timestamp
          && request.resource.data.get('donorHandoverConfirmed', false) == false
          && request.resource.data.get('requesterHandoverConfirmed', false) == false
          && reservationMatchesConversation();
      }

      function canCancel() {
        return resource.data.status == 'reserved'
          && request.resource.data.status == 'available'
          && (request.auth.uid == resource.data.donorId ||
              request.auth.uid == resource.data.get('reservedRequesterId', null))
          && resource.data.get('donorHandoverConfirmed', false) == false
          && resource.data.get('requesterHandoverConfirmed', false) == false
          && changedOnly([
            'status', 'reservedChatId', 'reservedRequesterId', 'pickupTime',
            'reservationDeadline', 'donorHandoverConfirmed', 'requesterHandoverConfirmed'
          ])
          && request.resource.data.get('reservedChatId', null) == null
          && request.resource.data.get('reservedRequesterId', null) == null
          && request.resource.data.get('pickupTime', null) == null
          && request.resource.data.get('reservationDeadline', null) == null
          && request.resource.data.get('donorHandoverConfirmed', false) == false
          && request.resource.data.get('requesterHandoverConfirmed', false) == false;
      }

      function canConfirmHandover() {
        let donorConfirmed = request.resource.data.get('donorHandoverConfirmed', false);
        let requesterConfirmed = request.resource.data.get('requesterHandoverConfirmed', false);
        return resource.data.status == 'reserved'
          && changedOnly(['status', 'donorHandoverConfirmed', 'requesterHandoverConfirmed'])
          && (
            (request.auth.uid == resource.data.donorId
              && donorConfirmed == true
              && requesterConfirmed == resource.data.get('requesterHandoverConfirmed', false)) ||
            (request.auth.uid == resource.data.get('reservedRequesterId', null)
              && requesterConfirmed == true
              && donorConfirmed == resource.data.get('donorHandoverConfirmed', false))
          )
          && ((donorConfirmed && requesterConfirmed && request.resource.data.status == 'completed') ||
              (!(donorConfirmed && requesterConfirmed) && request.resource.data.status == 'reserved'));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.status == 'available'
        && !isSuspended()
        // Địa chỉ và giờ hẹn chính xác không được nằm trên bài mọi người đều đọc được.
        && !request.resource.data.keys().hasAny(['pickupAddress', 'pickupTime'])
        && cleanText(request.resource.data.get('title', ''))
        && cleanText(request.resource.data.get('donorNote', ''))
        && validCloudinaryImages('catalog_item', itemId)
        && request.resource.data.get('reservedChatId', null) == null
        && request.resource.data.get('reservedRequesterId', null) == null
        && request.resource.data.get('donorHandoverConfirmed', false) == false
        && request.resource.data.get('requesterHandoverConfirmed', false) == false;

      allow update: if request.auth != null &&
        (canReserve() || canCancel() || canConfirmHandover());

      allow delete: if request.auth != null && resource.data.donorId == request.auth.uid;

      // Địa chỉ nhận đồ chính xác: chỉ người đăng và người đang được giữ đồ đọc được.
      match /private/{docId} {
        function parentBefore() {
          return get(/databases/$(database)/documents/catalog_items/$(itemId)).data;
        }

        function parentAfter() {
          return getAfter(/databases/$(database)/documents/catalog_items/$(itemId)).data;
        }

        allow read: if request.auth != null && docId == 'pickup'
          && (request.auth.uid == parentBefore().donorId ||
              request.auth.uid == parentBefore().get('reservedRequesterId', null));
        allow create, update: if request.auth != null && docId == 'pickup'
          && request.auth.uid == parentAfter().donorId
          && request.resource.data.keys().hasOnly(['pickupAddress'])
          && request.resource.data.pickupAddress is string
          && request.resource.data.pickupAddress.size() > 0
          && request.resource.data.pickupAddress.size() <= 200;
        allow delete: if request.auth != null && request.auth.uid == parentBefore().donorId;
      }
    }

    // 3. Conversations (In-App Chat 1-1)
    match /conversations/{chatId} {
      function itemAfter() {
        return getAfter(/databases/$(database)/documents/catalog_items/$(request.resource.data.itemId)).data;
      }

      function validConversationState() {
        let item = itemAfter();
        let belongsToChat = item.get('reservedChatId', null) == chatId;
        return (request.resource.data.get('isReserved', false) != true ||
                (item.status == 'reserved' && belongsToChat))
          && (request.resource.data.get('appointmentStatus', 'none') != 'accepted' ||
              (item.status == 'reserved' && belongsToChat))
          && (request.resource.data.get('appointmentStatus', 'none') != 'completed' ||
              (item.status == 'completed' && belongsToChat))
          && (request.resource.data.get('donorHandoverConfirmed', false) != true ||
              (belongsToChat && item.get('donorHandoverConfirmed', false) == true))
          && (request.resource.data.get('requesterHandoverConfirmed', false) != true ||
              (belongsToChat && item.get('requesterHandoverConfirmed', false) == true));
      }

      function changesOnlyOwnReadTime() {
        let before = resource.data.get('lastReadTimes', {});
        let after = request.resource.data.get('lastReadTimes', {});
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadTimes'])
          && after is map
          && before is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after.get(request.auth.uid, null) is timestamp;
      }

      function validWorkflowTransition() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let before = resource.data.get('appointmentStatus', 'none');
        let after = request.resource.data.get('appointmentStatus', 'none');
        let item = itemAfter();
        return !changed.hasAny([
          'appointmentStatus', 'isReserved', 'proposedPickupTime',
          'reservationDeadline', 'donorHandoverConfirmed', 'requesterHandoverConfirmed'
        ]) || (
          after == 'proposed'
          && before in ['none', 'proposed', 'declined', 'cancelled']
          && request.auth.uid == resource.data.requesterId
          && item.status in ['available', 'Sẵn sàng nhận đồ']
          && request.resource.data.get('isReserved', false) == false
          && request.resource.data.get('proposedPickupTime', null) is timestamp
          && changed.hasOnly([
            'appointmentStatus', 'proposedPickupTime',
            'lastMessage', 'lastMessageTime', 'lastSenderId'
          ])
        ) || (
          after == 'accepted'
          && before == 'proposed'
          && request.auth.uid == resource.data.donorId
          && item.status == 'reserved'
          && item.get('reservedChatId', null) == chatId
          && request.resource.data.get('isReserved', false) == true
          // Giờ hẹn không còn trên bài công khai; giờ đã chốt chỉ nằm trong hội thoại (người tặng có thể
          // đồng ý một thẻ đề xuất cũ hơn, nên không bắt trùng đề xuất mới nhất — giống hành vi trước đây).
          && request.resource.data.get('proposedPickupTime', null) is timestamp
          && request.resource.data.get('reservationDeadline', null) == item.get('reservationDeadline', null)
          && request.resource.data.reservationDeadline == request.resource.data.proposedPickupTime + duration.value(2, 'h')
          && changed.hasOnly([
            'appointmentStatus', 'isReserved', 'proposedPickupTime',
            'reservationDeadline', 'donorHandoverConfirmed',
            'requesterHandoverConfirmed', 'lastMessage',
            'lastMessageTime', 'lastSenderId'
          ])
        ) || (
          after == 'declined'
          && before == 'proposed'
          && request.auth.uid == resource.data.donorId
          && request.resource.data.get('isReserved', false) == false
          && changed.hasOnly([
            'appointmentStatus', 'lastMessage', 'lastMessageTime', 'lastSenderId'
          ])
        ) || (
          after == 'cancelled'
          && before == 'accepted'
          && item.status == 'available'
          && item.get('reservedChatId', null) == null
          && request.resource.data.get('isReserved', false) == false
          && request.resource.data.get('proposedPickupTime', null) == null
          && request.resource.data.get('reservationDeadline', null) == null
          && changed.hasOnly([
            'appointmentStatus', 'isReserved', 'proposedPickupTime',
            'reservationDeadline', 'donorHandoverConfirmed',
            'requesterHandoverConfirmed', 'lastMessage',
            'lastMessageTime', 'lastSenderId'
          ])
        ) || (
          after == 'completed'
          && before == 'accepted'
          && item.status == 'completed'
          && item.get('reservedChatId', null) == chatId
          && request.resource.data.get('isReserved', false) == false
          && changed.hasOnly([
            'appointmentStatus', 'isReserved', 'donorHandoverConfirmed',
            'requesterHandoverConfirmed', 'lastMessage',
            'lastMessageTime', 'lastSenderId'
          ])
        ) || (
          after == before
          && before == 'accepted'
          && item.status == 'reserved'
          && item.get('reservedChatId', null) == chatId
          && request.resource.data.get('donorHandoverConfirmed', false) == item.get('donorHandoverConfirmed', false)
          && request.resource.data.get('requesterHandoverConfirmed', false) == item.get('requesterHandoverConfirmed', false)
          && changed.hasOnly([
            'donorHandoverConfirmed', 'requesterHandoverConfirmed',
            'lastMessage', 'lastMessageTime', 'lastSenderId'
          ])
          && (
            (request.auth.uid == resource.data.donorId
              && request.resource.data.get('requesterHandoverConfirmed', false) == resource.data.get('requesterHandoverConfirmed', false)) ||
            (request.auth.uid == resource.data.requesterId
              && request.resource.data.get('donorHandoverConfirmed', false) == resource.data.get('donorHandoverConfirmed', false))
          )
        ) || (
          after == before
          && before in ['none', 'proposed']
          && request.auth.uid == resource.data.donorId
          && item.status == 'reserved'
          && item.get('reservedChatId', null) == chatId
          && request.resource.data.get('isReserved', false) == true
          && changed.hasOnly([
            'isReserved', 'lastMessage', 'lastMessageTime', 'lastSenderId'
          ])
        );
      }

      // Cho phép kiểm tra ID chat chưa tồn tại trước transaction tạo chat.
      allow get: if request.auth != null && (
        resource == null || request.auth.uid in resource.data.participantIds
      );
      allow list: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.requesterId
        && request.resource.data.requesterId != request.resource.data.donorId
        && request.resource.data.donorId == itemAfter().donorId
        && request.resource.data.itemId is string
        // Người nhắn tin chưa được giữ đồ thì không có bản sao địa chỉ nhận đồ.
        && !request.resource.data.keys().hasAny(['itemPickupAddress'])
        && request.resource.data.participantIds == [request.resource.data.donorId, request.resource.data.requesterId]
        && request.resource.data.lastSenderId == request.auth.uid
        && !blockedEitherWay(request.resource.data.donorId, request.resource.data.requesterId)
        && !isSuspended()
        // App tạo hội thoại kèm luôn tin đầu tiên làm bản xem trước: lọc như tin nhắn và như nhánh
        // update, nếu không người hỏi lách bộ lọc bằng cách đặt chữ thô tục vào lastMessage lúc tạo.
        && cleanText(request.resource.data.get('lastMessage', ''))
        && validConversationState();

      // Thành viên chỉ được cập nhật các trường metadata tin nhắn, lịch hẹn và bàn giao
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && (changesOnlyOwnReadTime() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageTime', 'lastSenderId', 'isReserved',
            'appointmentStatus', 'proposedPickupTime', 'reservationDeadline',
            'donorHandoverConfirmed', 'requesterHandoverConfirmed'
          ])
          && request.resource.data.lastSenderId == request.auth.uid
          // Bản xem trước (lastMessage) là nội dung người kia thấy ở danh sách chat: chặn/lọc như tin nhắn,
          // nếu không người bị chặn vẫn ghi riêng trường này để gửi chữ tới người đã chặn mình.
          && !blockedEitherWay(resource.data.donorId, resource.data.requesterId)
          && !isSuspended()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || cleanText(request.resource.data.get('lastMessage', '')))
          && validConversationState()
          && validWorkflowTransition()
        ));

      // Sub-collection: Messages
      // Chỉ thành viên của cuộc trò chuyện cha mới được đọc và gửi tin nhắn
      match /messages/{messageId} {
        function conversationAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(chatId)).data;
        }

        function itemAfter() {
          return getAfter(/databases/$(database)/documents/catalog_items/$(conversationAfter().itemId)).data;
        }

        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participantIds;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('messageType', 'text') != 'system'
          && request.auth.uid in conversationAfter().participantIds
          && !blockedEitherWay(conversationAfter().donorId, conversationAfter().requesterId)
          && !isSuspended()
          && cleanText(request.resource.data.get('text', ''));
        // Cho phép cập nhật trạng thái thẻ đề xuất hẹn (appointmentStatus)
        allow update: if request.auth != null
          && request.auth.uid == conversationAfter().donorId
          && resource.data.messageType == 'appointment_proposal'
          && resource.data.appointmentStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appointmentStatus'])
          && (request.resource.data.appointmentStatus == 'declined' ||
              (request.resource.data.appointmentStatus == 'accepted'
                && itemAfter().status == 'reserved'
                && itemAfter().reservedChatId == chatId));
        allow delete: if false;
      }
    }

    // 4. Donations (Quyên góp tập trung về Trạm Hub)
    match /donations/{donationId} {
      function validNewDonation() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'id', 'donorId', 'title', 'description', 'category',
            'condition', 'status', 'imageProvider', 'imagePublicIds', 'createdAt'
          ])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 120
          && data.description is string
          && data.category in ['clothing', 'books', 'household']
          && (!data.keys().hasAny(['donorConfirmedCategory']) ||
              data.donorConfirmedCategory == data.category)
          && (data.keys().hasAll(['aiPredictedCategory', 'aiConfidence', 'aiModelVersion']) ||
              !data.keys().hasAny(['aiPredictedCategory', 'aiConfidence', 'aiModelVersion']))
          && (!data.keys().hasAny(['aiPredictedCategory']) ||
              (data.aiPredictedCategory in ['clothing', 'books', 'household']
                && data.aiConfidence is number
                && data.aiConfidence >= 0
                && data.aiConfidence <= 1
                && data.aiModelVersion == 'ReShare_v8_baseline_01'))
          && data.condition in ['new', 'like_new', 'good', 'fair']
          && ((!data.keys().hasAny(['quantity', 'unitId'])) ||
              (data.keys().hasAll(['quantity', 'unitId'])
                && data.quantity is number
                && data.quantity > 0
                && data.unitId in ['piece', 'kg', 'bag', 'box', 'set']
                && (data.unitId == 'kg'
                  ? (data.quantity * 1000 <= 9007199254740991 && data.quantity == math.round(data.quantity * 1000) / 1000.0)
                  : (data.quantity <= 9007199254740991 && data.quantity == math.floor(data.quantity)))))
          && data.createdAt is timestamp
          && data.imageProvider == 'cloudinary'
          && !data.keys().hasAny(['warehouseId', 'warehouseName', 'imageUploadRecordId', 'resubmittedAt'])
          && (!data.keys().hasAny(['campaignId']) || validCampaignDonation(data))
          && (!data.keys().hasAny(['hubName']) || validHubName(data))
          && validCloudinaryImages('donation', donationId);
      }

      // Tên điểm lưu kèm đơn (giống biên nhận) phải đúng tên điểm tiếp nhận lúc gửi, không do client
      // tự đặt: lịch sử của người quyên góp hiển thị tên này kể cả khi điểm đổi tên hoặc ngừng hoạt động.
      function validHubName(data) {
        let hubPath = /databases/$(database)/documents/hubs/$(data.get('hubId', ''));
        return data.get('hubId', null) is string
          && data.hubId.matches('^[A-Za-z0-9_-]{1,128}$')
          && data.hubName is string
          && exists(hubPath)
          && get(hubPath).data.name == data.hubName;
      }

      // Đơn gửi cho chiến dịch phải trỏ tới chiến dịch đang mở, chưa quá hạn và cùng danh mục,
      // để tiến độ (cộng lúc nhập kho) không nhận đơn của chiến dịch nháp/đã đóng hoặc sai loại đồ.
      function validCampaignDonation(data) {
        let campaignPath = /databases/$(database)/documents/campaigns/$(data.campaignId);
        return data.campaignId is string
          && data.campaignId.matches('^[A-Za-z0-9_-]{1,128}$')
          && exists(campaignPath)
          && get(campaignPath).data.status == 'active'
          && get(campaignPath).data.category == data.category
          && get(campaignPath).data.endDate > request.time;
      }

      function canStaffReadDonation() {
        let assignedWarehouse = resource.data.get('warehouseId', null);
        return isSystemAdmin() || (
          assignedWarehouse != null && canReadWarehouse(assignedWarehouse)
        );
      }

      // Cho phép kiểm tra ID chưa tồn tại để transaction tạo đơn có thể retry an toàn.
      allow get: if request.auth != null && (
        resource == null ||
        resource.data.donorId == request.auth.uid ||
        canStaffReadDonation()
      );
      allow list: if request.auth != null && (
        resource.data.donorId == request.auth.uid ||
        canStaffReadDonation()
      );
      allow create: if request.auth != null
        && request.resource.data.id == donationId
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['internalNote', 'reviewedBy', 'history'])
        && !isSuspended()
        && validNewDonation();
      // Review decisions go through the trusted API so private fields stay separate.
      allow update: if false;
      allow delete: if false;
    }

    match /donation_reviews/{donationId} {
      allow read, write: if false;
    }

    match /donation_resubmissions/{revisionId} {
      allow read, write: if false;
    }

    match /warehouse_inventory_updates/{scopeId} {
      allow read, write: if false;
    }

    // Phiếu thực nhận chỉ đọc được theo phân công kho; mọi thao tác ghi qua API tin cậy.
    match /receipts/{receiptId} {
      allow read: if request.auth != null && (
        isSystemAdmin() ||
        (activeStaffWithRole('warehouse_admin') && canReadWarehouse(resource.data.warehouseId))
      );
      allow write: if false;
    }

    // Báo cáo vi phạm (Guideline 1.2): người dùng chỉ tạo được; không ai đọc hay sửa từ client.
    // System Admin xem và xử lý qua backend (moderation-api.cjs).
    match /reports/{reportId} {
      // Người bị báo cáo phải đúng là chủ của nội dung: chủ bài đăng, người gửi tin nhắn, hoặc chính
      // người dùng được báo cáo. Không thì người báo cáo có thể gán bài của A cho B và lừa admin khoá nhầm B.
      function validReportTarget(data) {
        let cleanId = '^[A-Za-z0-9_-]{1,200}$';
        let listingPath = /databases/$(database)/documents/catalog_items/$(data.targetId);
        return data.targetId.matches(cleanId) && (
          (data.targetType == 'user'
            && !data.keys().hasAny(['conversationId'])
            && data.targetId == data.targetUserId)
          || (data.targetType == 'listing'
            && !data.keys().hasAny(['conversationId'])
            && exists(listingPath)
            && get(listingPath).data.donorId == data.targetUserId)
          || (data.targetType == 'message'
            && data.get('conversationId', null) is string
            && data.conversationId.matches(cleanId)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(data.conversationId)).data.participantIds
            && exists(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.targetId))
            && get(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.targetId)).data.senderId == data.targetUserId));
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'targetUserId', 'conversationId',
          'reason', 'note', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reporterId', 'targetType', 'targetId', 'targetUserId', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId.size() > 0
        && request.resource.data.targetUserId.size() <= 128
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.reason in ['spam', 'scam', 'inappropriate', 'harassment', 'prohibited_item', 'other']
        && (!request.resource.data.keys().hasAny(['note']) ||
            (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && validReportTarget(request.resource.data);
      allow read, update, delete: if false;
    }

    // Contact records are accepted and accessed only by the trusted backend using Admin SDK.
    match /contacts/{contactId} {
      allow read, write: if false;
    }

    // Rate-limit records contain keyed anti-abuse metadata and are backend-only.
    match /contact_rate_limits/{rateLimitId} {
      allow read, write: if false;
    }

    // 5. Campaigns & Hubs (Chiến dịch & Trạm tiếp nhận - Công khai để xem)
    // Chỉ chiến dịch đã công khai (đang mở hoặc đã đóng) được đọc; bản nháp không lộ ra app.
    // Mọi thao tác ghi đi qua backend (campaigns-api.cjs) bằng Admin SDK, kể cả System Admin.
    match /campaigns/{campaignId} {
      allow read: if resource.data.status in ['active', 'closed'];
      allow write: if false;
    }

    match /hubs/{hubId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
